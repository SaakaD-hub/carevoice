# Copy to .env and fill in. Never commit .env.

# ---- Database ----
DB_NAME=carevoice
DB_USER=carevoice
DB_PASSWORD=change-me

# ---- Splunk ----
# Local: Splunk runs in Docker. Password must be 8+ characters.
SPLUNK_PASSWORD=ChangeMe123!
# Any UUID. Generate one with:  uuidgen   (or python3 -c "import uuid; print(uuid.uuid4())")
SPLUNK_HEC_TOKEN=00000000-0000-0000-0000-000000000000
SPLUNK_HEC_URL=https://localhost:8088
SPLUNK_INDEX=main
# Production (Splunk Cloud): use the HEC URL and token from your Splunk Cloud instance, e.g.
# SPLUNK_HEC_URL=https://http-inputs-<your-stack>.splunkcloud.com:443

# ---- AI services ----
STT_API_KEY=
LLM_API_KEY=

# ---- App ----
APP_ENV=local
# Production only: the domain that points to your server
DOMAIN=carevoice.example.com
